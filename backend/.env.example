# Flask
FLASK_ENV=development

# Secrets - replace these with real values. NEVER commit real secrets.
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-different-long-random-string

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aec_compliance

# Comma-separated list of allowed frontend origins (no trailing slashes)
# Example: http://localhost:3000,https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT access/refresh token lifetime (seconds)
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# JWT transport is the Authorization: Bearer <token> header; tokens are
# returned in JSON bodies. The cookie flags below are reserved for the
# frontend-integration phase and are inert in header mode.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_CSRF_PROTECT=true

# Password reset
# Reset-token validity in seconds (default 30 minutes)
PASSWORD_RESET_TOKEN_TTL=1800
# Base URL used to build password-reset links in emails
FRONTEND_BASE_URL=http://localhost:3000

# Uploads
# Directory (relative to backend/) where uploaded evidence files are stored.
# In production this should be a persistent, backed-up path.
UPLOAD_DIR=uploads
# Maximum upload size in bytes (default 16 MB)
MAX_CONTENT_LENGTH=16777216

# Email (Flask-Mail / SMTP)
# SMTP_HOST / SMTP_PORT / SMTP_USERNAME / SMTP_PASSWORD are the primary keys;
# MAIL_* aliases are accepted for compatibility with Flask-Mail conventions.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_DEFAULT_SENDER=AEC Compliance Portal <no-reply@ansumana.com>

# WhatsApp notifications (integration added in a later phase)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_PHONE=

# Rate limiting (Flask-Limiter)
# Example values: "200 per hour", "5 per minute"
RATELIMIT_DEFAULT=200 per hour
# Set false to disable rate limiting entirely (dev/tests).
RATELIMIT_ENABLED=true
# In-memory storage is fine for a single dev process. Use a shared backend
# (e.g. redis://...) when running multiple workers in production.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_HEADERS_ENABLED=false

# Per-IP authentication rate limits
AUTH_LOGIN_RATE=5 per minute
AUTH_REGISTER_RATE=10 per hour
AUTH_FORGOT_PASSWORD_RATE=5 per hour
AUTH_RESET_PASSWORD_RATE=10 per hour

# Per-IP rate limits for the public (unauthenticated) API
PUBLIC_BOOKINGS_RATE=10 per hour
PUBLIC_SERVICE_REQUESTS_RATE=10 per hour
PUBLIC_PERMIT_STATUS_RATE=30 per minute

# Admin account (flask create-admin)
# Password is REQUIRED (via this env var, --password, or an interactive
# prompt) and is never printed or logged.
AEC_ADMIN_EMAIL=info@ansumana.com
AEC_ADMIN_NAME=Dr. Ansumana Kamara (AEC Admin)
# AEC_ADMIN_PASSWORD=

# Demo seed (flask seed-demo)
# When set, client accounts in the demo seed use this password. When unset,
# they receive a random password (set this and re-run with --force to assign).
# AEC_DEMO_PASSWORD=

# Tests (pytest) always use an in-memory SQLite database. Set this only if
# you need tests to run against a real database instead.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aec_compliance_test