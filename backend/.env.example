# Flask
FLASK_ENV=development

# Secrets - replace these with real values. NEVER commit real secrets.
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-different-long-random-string

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aec_compliance

# Comma-separated list of allowed frontend origins (no trailing slashes)
# Example: http://localhost:3000,https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT access/refresh token lifetime (seconds)
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Cookie-based JWT transport (auth phase). Never set JWT_COOKIE_SECURE=true
# over plain HTTP; it is required for production HTTPS only.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_CSRF_PROTECT=true

# Uploads
# Directory (relative to backend/) where uploaded evidence files are stored.
# In production this should be a persistent, backed-up path.
UPLOAD_DIR=uploads
# Maximum upload size in bytes (default 16 MB)
MAX_CONTENT_LENGTH=16777216

# Email (Flask-Mail / SMTP)
# SMTP_HOST / SMTP_PORT / SMTP_USERNAME / SMTP_PASSWORD are the primary keys;
# MAIL_* aliases are accepted for compatibility with Flask-Mail conventions.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_DEFAULT_SENDER=AEC Compliance Portal <no-reply@ansumana.com>

# WhatsApp notifications (integration added in a later phase)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_PHONE=

# Rate limiting (Flask-Limiter)
# Example values: "200 per hour", "5 per minute"
RATELIMIT_DEFAULT=200 per hour
# In-memory storage is fine for a single dev process. Use a shared backend
# (e.g. redis://...) when running multiple workers in production.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_HEADERS_ENABLED=false

# Tests (pytest) always use an in-memory SQLite database. Set this only if
# you need tests to run against a real database instead.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aec_compliance_test